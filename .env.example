# AIOS Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── LLM API Keys (at least one required) ──────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ── Infrastructure ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# ── Runtime Configuration ─────────────────────────────────────
AIOS_ENV=development          # development | staging | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
AIOS_CONFIG_PATH=configs/aios_config.yaml

# ── Monitoring ─────────────────────────────────────────────────
OTEL_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=aios

# ── Security ───────────────────────────────────────────────────
# Optional: set to enable API key authentication on all /v1/ endpoints
AIOS_API_KEY=
